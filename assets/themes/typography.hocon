// TinyCast 字体排版配置
// 支持 HOCON 格式，可添加 # 或 // 注释

{
  "version": 0.1,
  "name": "Typography",

  // 标题字号体系
  "heading": {
    // 大标题：页面主标题
    "largetitle": {
      "desktop": {
        "fontsize": "12",
        "fontweight": "bold",
        "lineheight": "16/12"
      },
      "tablet": {
        "desktop": "16",
        "tablet": "16",
        "mobile": "24"
      },
      "mobile": {
        "desktop": "14",
        "tablet": "14",
        "mobile": "20"
      }
    },
    // 一级标题
    "title1": {
      "desktop": {
        "fontsize": "16",
        "fontweight": "bold",
        "lineheight": "16/12"
      },
      "tablet": {
        "fontsize": "14",
        "fontweight": "bold",
        "lineheight": "14/12"
      },
      "mobile": {
        "fontsize": "18",
        "fontweight": "bold",
        "lineheight": "18/12"
      }
    },
    // 二级标题
    "title2": {
      "desktop": {
        "fontsize": "14",
        "fontweight": "bold",
        "lineheight": "14/12"
      },
      "tablet": {
        "fontsize": "12",
        "fontweight": "bold",
        "lineheight": "12/12"
      },
      "mobile": {
        "fontsize": "16",
        "fontweight": "bold",
        "lineheight": "16/12"
      }
    },
    // 三级标题
    "title3": {
      "desktop": {
        "fontsize": "16",
        "fontweight": "bold",
        "lineheight": "16/12"
      },
      "tablet": {
        "fontsize": "14",
        "fontweight": "bold",
        "lineheight": "14/12"
      },
      "mobile": {
        "fontsize": "18",
        "fontweight": "bold",
        "lineheight": "18/12"
      }
    },
    // 副标题
    "headline": {
      "desktop": {
        "fontsize": "18",
        "fontweight": "bold",
        "lineheight": "18/12"
      },
      "tablet": {
        "fontsize": "16",
        "fontweight": "bold",
        "lineheight": "16/12"
      },
      "mobile": {
        "fontsize": "18",
        "fontweight": "bold",
        "lineheight": "18/12"
      }
    }
  }
}
